# Font
font-family = "SauceCodePro Nerd Font"
font-style = Regular
font-size = 16

# Appearance
theme = "Kanagawa Wave"
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor
cursor-style = bar
cursor-click-to-move = true

# Shell integration
shell-integration-features = no-cursor,no-title,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Performance and input
mouse-scroll-multiplier = 0.95
async-backend = epoll

#############################
########## Tmux-style bindings (prefix: ctrl+a)
#############################
# Mirrors ~/.tmux.conf where possible.
#
# NOTE: consuming ctrl+a means the readline "beginning of line" key is
# captured while a sequence is pending. Press ctrl+a twice to send a real
# ctrl+a to the shell (same as tmux's send-prefix).

# Prefix C-a -> send-prefix (literal ctrl+a to the running program)
keybind = ctrl+a>ctrl+a=text:\x01

# Splits: prefix + = (vertical) / - (horizontal), opens in cwd via shell integration
keybind = ctrl+a>==new_split:right
keybind = ctrl+a>-=new_split:down

# Pane navigation: prefix + hjkl ...
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right

# ... and raw ctrl+hjkl (no prefix), like tmux's smart vim-aware switching.
# (The vim-awareness part lives in nvim; see nvim/lua/plugins/tmux.lua)
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right

# Windows <-> tabs: shift+arrows without prefix, like tmux -n S-Left/S-Right
# (unbind the default shift+arrow selection-adjust first)
keybind = shift+left=unbind
keybind = shift+right=unbind
keybind = shift+up=unbind
keybind = shift+down=unbind
keybind = shift+left=previous_tab
keybind = shift+right=next_tab

# New window/tab: prefix + c (tmux new-window)
keybind = ctrl+a>c=new_tab

# Goto window 1-9: prefix + number
keybind = ctrl+a>1=goto_tab:1
keybind = ctrl+a>2=goto_tab:2
keybind = ctrl+a>3=goto_tab:3
keybind = ctrl+a>4=goto_tab:4
keybind = ctrl+a>5=goto_tab:5
keybind = ctrl+a>6=goto_tab:6
keybind = ctrl+a>7=goto_tab:7
keybind = ctrl+a>8=goto_tab:8
keybind = ctrl+a>9=goto_tab:9

# Zoom pane: prefix + z, close pane: prefix + x
keybind = ctrl+a>z=toggle_split_zoom
keybind = ctrl+a>x=close_surface

# Resize: prefix + D = 8 lines down (mirrors tmux bind D); fine-grained
# resizing stays on super+ctrl+arrows (10px) and super+ctrl+alt+shift (100px)
keybind = ctrl+a>D=resize_split:down,8

# Reload config: prefix + r
keybind = ctrl+a>r=reload_config

# Edit config in $EDITOR: prefix + e (opens ghostty config)
keybind = ctrl+a>e=open_config

# Clear screen + history: prefix + y
keybind = ctrl+a>y=clear_screen

# Search (copy-mode ?): prefix + /
keybind = ctrl+a>slash=start_search

# Session switching has no true ghostty equivalent. Best-effort:
# prefix + s -> tab overview (choose-tree-ish), prefix + p -> command palette
keybind = ctrl+a>s=toggle_tab_overview
keybind = ctrl+a>p=toggle_command_palette
