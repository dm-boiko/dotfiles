# Font
font-family = "SauceCodePro Nerd Font"
font-style = Regular
font-size = 16

# Appearance
theme = "Kanagawa Wave"
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor
cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = true

# Shell integration
shell-integration-features = no-cursor,no-title,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Performance and input
mouse-scroll-multiplier = 0.95
async-backend = epoll

#############################
########## Tmux-style bindings (prefix: ctrl+a)
#############################
# Mirrors ~/.tmux.conf where possible.
# Uses cross-platform W3C physical key codes so keyboard layouts and input
# methods cannot change how the bindings match (supported on Linux and macOS).
#
# Ctrl+A activates a one-shot table: the next valid command runs and exits it.
# Unknown commands are consumed by catch_all and also exit the table. Press
# ctrl+a twice to send a real ctrl+a to the shell (tmux's send-prefix).

keybind = ctrl+KeyA=activate_key_table_once:tmux

# Prefix C-a -> send-prefix (literal ctrl+a to the running program)
keybind = tmux/ctrl+KeyA=text:\x01

# Splits: prefix + = (vertical) / - (horizontal), opens in cwd via shell integration
keybind = tmux/Equal=new_split:right
keybind = tmux/Minus=new_split:down

# Pane navigation: prefix + hjkl ...
keybind = tmux/KeyH=goto_split:left
keybind = tmux/KeyJ=goto_split:down
keybind = tmux/KeyK=goto_split:up
keybind = tmux/KeyL=goto_split:right

# ... and raw ctrl+hjkl (no prefix), like tmux's smart vim-aware switching.
# (The vim-awareness part lives in nvim; see nvim/lua/plugins/tmux.lua)
keybind = ctrl+KeyH=goto_split:left
keybind = ctrl+KeyJ=goto_split:down
keybind = ctrl+KeyK=goto_split:up
keybind = ctrl+KeyL=goto_split:right

# Windows <-> tabs: shift+arrows without prefix, like tmux -n S-Left/S-Right
# (unbind the default shift+arrow selection-adjust first)
keybind = shift+left=unbind
keybind = shift+right=unbind
keybind = shift+up=unbind
keybind = shift+down=unbind
keybind = shift+left=previous_tab
keybind = shift+right=next_tab

# New window/tab: prefix + c (tmux new-window)
keybind = tmux/KeyC=new_tab

# Goto window 1-9: prefix + number
keybind = tmux/Digit1=goto_tab:1
keybind = tmux/Digit2=goto_tab:2
keybind = tmux/Digit3=goto_tab:3
keybind = tmux/Digit4=goto_tab:4
keybind = tmux/Digit5=goto_tab:5
keybind = tmux/Digit6=goto_tab:6
keybind = tmux/Digit7=goto_tab:7
keybind = tmux/Digit8=goto_tab:8
keybind = tmux/Digit9=goto_tab:9

# Zoom pane: prefix + z, close pane: prefix + x
keybind = tmux/KeyZ=toggle_split_zoom
keybind = tmux/KeyX=close_surface

# Resize: prefix + D = 8 lines down (mirrors tmux bind D); fine-grained
# resizing stays on super+ctrl+arrows (10px) and super+ctrl+alt+shift (100px)
keybind = tmux/KeyD=resize_split:down,8

# Reload config: prefix + r
keybind = tmux/KeyR=reload_config

# Edit config in $EDITOR: prefix + e (opens ghostty config)
keybind = tmux/KeyE=open_config

# Clear screen + history: prefix + y
keybind = tmux/KeyY=clear_screen

# Search (copy-mode ?): prefix + /
keybind = tmux/Slash=start_search

# Session switching has no true ghostty equivalent. Best-effort:
# prefix + s -> tab overview (choose-tree-ish), prefix + p -> command palette
keybind = tmux/KeyS=toggle_tab_overview
keybind = tmux/KeyP=toggle_command_palette

# Cancel the one-shot table after any unknown command.
keybind = tmux/catch_all=deactivate_key_table
