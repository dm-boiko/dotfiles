[Unit]
Description=Gracefully close web browsers before shutdown
Documentation=man:systemd.special(7)
PartOf=graphical-session.target
After=graphical-session.target app-graphical.slice

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/home/d/.local/bin/graceful-browser-shutdown
TimeoutStopSec=18s

[Install]
WantedBy=graphical-session.target
